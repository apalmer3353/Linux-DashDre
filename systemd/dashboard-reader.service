[Unit]
Description=Pipe reader for my Linux dashboard
After=systemd-tmpfiles-setup.service
RequiresMountsFor=/run/dashboard

[Service]
Type=simple
User=dashboard-agent
Group=dashboard-agent
ExecStart=/usr/bin/python3 /home/dre997005/linux-dashboard/agent/pipe_reader.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
